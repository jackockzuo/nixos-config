# ============================================================
# network/default.nix —— 网络配置聚合
# 原则：一目录一领域，一文件一关注点
#   新增关注点 → 新建 <方面>.nix，并在下方 imports 加一行
#   修改某方面 → 只编辑对应文件，不跨文件散布
# ============================================================
{ ... }:

{
  imports = [
    ./proxy.nix # 代理（fcclient 环境变量 + fish 开关函数）

    # ---- 🔮 预留模块（需要时取消注释）----
    # ./browsers.nix # 浏览器用户配置（Firefox/Chromium）
  ];
}

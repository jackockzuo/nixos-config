# ============================================================
# monitoring/default.nix —— 系统监控领域聚合
# 原则：按领域分文件夹，文件夹里按工具分文件；有配置的工具每工具一文件
# 本领域：系统监控类工具（btop 进程监控 / cava 音频可视化）
# 新增 → 新建 <工具>.nix 并在此加一行
# ============================================================
_:

{
  imports = [
    ./btop.nix # btop：进程/CPU/内存/网络监控（Catppuccin Mocha）
    ./cava.nix # cava：音频可视化（Catppuccin Mocha）
  ];
}

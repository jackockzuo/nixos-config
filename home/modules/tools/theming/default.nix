# ============================================================
# theming/default.nix —— 主题联动领域聚合
# 原则：终端/桌面配色由外部工具联动生成（DMS 换壁纸 → matugen 渲染模板），
#       声明式配置只负责模板与映射
# 每个子模块独立关注点，可按需增删
# 新增 → 新建 <关注点>.nix 并在此加一行；预留 → 取消注释
# ============================================================
{ ... }:

{
  imports = [
    ./matugen.nix # 壁纸联动：DMS 换壁纸时自动生成 fish 配色
  ];
}
